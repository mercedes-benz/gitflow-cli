#!/bin/sh

# Adds a Developer Certificate of Origin (DCO) sign-off to every commit message:
#   Signed-off-by: Name <email>
# Equivalent to "git commit -s". The trailer is not duplicated if it already exists
# (e.g. on "git commit --amend" or when committing with -s).

COMMIT_MSG_FILE=$1

SIGNOFF="Signed-off-by: $(git config user.name) <$(git config user.email)>"

git interpret-trailers --in-place --if-exists doNothing --trailer "$SIGNOFF" "$COMMIT_MSG_FILE"
